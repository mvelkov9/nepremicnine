# ── Database ────────────────────────────────────────────
POSTGRES_USER=nepremicnine
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=nepremicnine
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nepremicnine:changeme_in_production@postgres:5432/nepremicnine

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# ── JWT ─────────────────────────────────────────────────
# Generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=changeme_generate_a_real_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ────────────────────────────────────────────────
# Dev: http://localhost:5173  |  Prod: https://yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── App ─────────────────────────────────────────────────
# development | production | test
APP_ENV=development
APP_VERSION=0.3.1
