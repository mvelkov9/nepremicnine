{
  "name": "nepremicnine-frontend",
  "version": "0.12.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NUXT_BUILD_DIR=.nuxt-dev NUXT_OUTPUT_DIR=.output-dev nuxt dev",
    "build": "NUXT_BUILD_DIR=.nuxt-build NUXT_OUTPUT_DIR=.output-build nuxt build",
    "postinstall": "NUXT_BUILD_DIR=.nuxt-dev NUXT_OUTPUT_DIR=.output-dev nuxt prepare",
    "preview": "NUXT_BUILD_DIR=.nuxt-preview NUXT_OUTPUT_DIR=.output-build nuxt preview",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{vue,js,ts,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{vue,js,ts,css,json,md}\"",
    "typecheck": "NUXT_BUILD_DIR=.nuxt-typecheck NUXT_OUTPUT_DIR=.output-typecheck nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@nuxt/ui": "^4.5.1",
    "@nuxtjs/i18n": "^10.2.3",
    "@pinia/nuxt": "^0.11.1",
    "chart.js": "^4.4.7",
    "leaflet": "^1.9.4",
    "nuxt": "^4.4.2",
    "pinia": "^3.0.4",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.2",
    "vue-i18n": "^11.3.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.98",
    "@nuxt/test-utils": "^4.0.0",
    "@typescript-eslint/parser": "^8.33.0",
    "@vue/test-utils": "^2.4.6",
    "@vueuse/nuxt": "^14.2.1",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.8.0",
    "happy-dom": "^20.8.4",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.2.1",
    "vitest": "^4.1.0",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.6"
  },
  "packageManager": "pnpm@10.32.1"
}
