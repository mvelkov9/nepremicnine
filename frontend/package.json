{
  "name": "nepremicnine-frontend",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix && prettier --write \"src/**/*.{vue,js,ts,css,json}\"",
    "format": "prettier --write \"src/**/*.{vue,js,ts,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{vue,js,ts,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@primeuix/themes": "^3.0.0",
    "@vueuse/core": "^14.3.0",
    "axios": "^1.18.1",
    "chart.js": "^4.5.1",
    "leaflet": "^1.9.4",
    "pinia": "^4.0.2",
    "primeicons": "^8.0.0",
    "primevue": "^5.0.0",
    "vue": "^3.5.40",
    "vue-chartjs": "^5.3.4",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@primevue/auto-import-resolver": "^5.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.1.1",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.7.0",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "packageManager": "pnpm@9.15.4"
}
