# ── Local Development (pnpm dev) ────────────────────────────────────────────
# Copy this file to .env (gitignored) when running services locally.
# Backend connects to localhost instead of Docker service names.
#
# Usage:
#   cp .env.local.example .env
#   docker compose -f docker-compose.dev.yml up -d   # start postgres, redis, backend, worker
#   cd frontend && pnpm dev                           # start frontend on localhost:5173

# ── Database ────────────────────────────────────────────
POSTGRES_USER=nepremicnine
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=nepremicnine
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://nepremicnine:changeme_in_production@localhost:5432/nepremicnine

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
TRAINING_JOB_TIMEOUT_SEC=86400
REDIS_PORT=6379

# ── JWT ─────────────────────────────────────────────────
JWT_SECRET_KEY=dev-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173

# ── App ─────────────────────────────────────────────────
APP_ENV=development
APP_VERSION=0.15.0
MAX_UPLOAD_SIZE_MB=10240
ENABLE_PREDICTION_ENRICHMENT=1

# ── CatBoost / GPU ─────────────────────────────────────
# Force GPU training (auto-detected by default, set explicitly if detection fails)
# Requires NVIDIA GPU + drivers. Speeds up training 10-50x.
# CATBOOST_TASK_TYPE=GPU
# CATBOOST_GPU_RAM_PART=0.50
